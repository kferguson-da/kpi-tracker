// Prisma schema for the KPI Tracker.
// Phase 0 introduces only User (ownership-based auth; no global roles).
// KPI / Reading / View / ViewKpi / ViewAccess arrive in Phase 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("users")
}
