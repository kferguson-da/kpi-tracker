// Prisma schema — the single source of truth for models and relations.
// Raw SQL is allowed only in generated migrations under prisma/migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  viewer
  editor
  admin
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(viewer)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
