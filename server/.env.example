# Copy to .env for local development.

# One of: development | test | production
NODE_ENV=development
PORT=3000

# Postgres connection string. Required in production; optional locally until you
# run migrations (api tests use a fake Prisma and do not need it).
DATABASE_URL=postgresql://kpi:kpi@localhost:5432/kpi_tracker

# The email that is granted app-admin on first login.
SEED_ADMIN_EMAIL=kevin@dealershipaccelerator.io

# Local-only: stands in for Cloudflare Access identity when NODE_ENV != production.
DEV_LOGIN_EMAIL=kevin@dealershipaccelerator.io
