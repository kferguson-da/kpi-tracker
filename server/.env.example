# Local development environment for the KPI server.
# Copy to `.env` and adjust. In production these are provided by systemd / SSM,
# not a committed file. Node loads this file via process.loadEnvFile() if present.

NODE_ENV=development
PORT=3000

# Local Postgres (see docs/LOCAL_DEV.md for setup)
DATABASE_URL=postgresql://kpi:kpi@localhost:5432/kpi_tracker?schema=public

# Auth (used by the auth slice)
# CF_ACCESS_TEAM_DOMAIN=dealershipaccelerator.cloudflareaccess.com
# CF_ACCESS_AUD=<application-audience-tag>
# DEV_LOGIN_EMAIL=you@dealershipaccelerator.io
# SEED_ADMIN_EMAIL=you@dealershipaccelerator.io
